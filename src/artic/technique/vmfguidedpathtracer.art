mod vmf {
    use super as all;
    use super::math_builtins;
    use super::color_builtins;

    type Mat3x3 = all::Mat3x3;
    type Vec3 = all::Vec3;
    type Vec2 = all::Vec2;
    type Color = all::Color;

    fn @compute_normalization(kappa: f32) -> f32 {
        if kappa > 0 {
            let k = math_builtins::exp(-2 * kappa);
            super::safe_div(kappa, 2 * super::flt_pi * (1 - k))
        } else {
            super::uniform_sphere_pdf()
        }
    }

    fn @vmf_pdf_1(cosTheta: f32, kappa: f32, norm: f32) -> f32 {
        let cosThetaMinusOne = math_builtins::fmin[f32](cosTheta - 1, 0);
        norm * math_builtins::exp(kappa * cosThetaMinusOne)
    }

    fn @vmf_sample(uv: Vec2, mean: Vec3, kappa: f32, norm: f32) -> super::DirSample {
        if kappa > 0 {
            let k = math_builtins::exp(-2 * kappa);
            let v = 1 + math_builtins::log(1 + ((k - 1) * uv.x)) / kappa;
            let c = super::clampf(v, -1, 1);
            let s = super::safe_sqrt(1 - c * c);

            let phi = uv.y * 2 * super::flt_pi;

            let sample = super::make_dir_sample_from_thetaphi(c, s, phi, vmf_pdf_1(c, kappa, norm));

            sample.{
                dir = super::mat3x3_mul(super::make_orthonormal_mat3x3(mean), sample.dir)
            }
        } else {
            super::sample_uniform_sphere(uv.x, uv.y)
        }
    }

    fn @vmf_pdf(dir: Vec3, mean: Vec3, kappa: f32, norm: f32) = vmf_pdf_1(super::vec3_dot(dir, mean), kappa, norm);

    fn @vmf_product(mean1: Vec3, kappa1: f32, mean2: Vec3, kappa2: f32) -> (Vec3, f32, f32) {
        let newMeanOpt  = super::vec3_add(super::vec3_mulf(mean1, kappa1), super::vec3_mulf(mean2, kappa2));
        let newKappaOpt = super::vec3_len(newMeanOpt);

        let kappaGood = newKappaOpt > 1e-3;
    
        let newKappa = super::select(kappaGood, newKappaOpt, 0:f32);
        let newMean  = super::select(kappaGood, super::vec3_mulf(newMeanOpt, 1 / newKappaOpt), mean1);
        let newNorm  = super::select(kappaGood, compute_normalization(newKappaOpt), compute_normalization(0));

        (newMean, newKappa, newNorm)
    }

    fn @vmf_cosine_product(mean: Vec3, kappa: f32, normal: Vec3) = vmf_product(mean, kappa, normal, 2.18853);

    struct GuidingCell {
        accum_mean:   Vec3,
        accum_weight: f32,
        mean:         Vec3,
        kappa:        f32,
        norm:         f32,
    }
    static GuidingCellMemoryFootprint = 12; // Padded to 4 unit mark for load_vec4 
    static NormalOctant = 1;//8;

    struct GuidingCellAccessor {
        cell:   fn () -> GuidingCell,
        splat:  fn (Vec3, Color) -> (),
        pdf:    fn (Vec3) -> f32,
        sample: fn (Vec2) -> super::DirSample,
        prob:   fn () -> f32,
    }

    struct GuidingCache {
        compute_index:  fn (Vec3, Vec3) -> super::Option[i32],
        get_from_index: fn (i32, Vec3) -> GuidingCellAccessor,
        normalize_host: fn (f32) -> (),                  // Normalize on the host 
        reset_host:     fn () -> (),                     // Reset on the host 
    }

    fn @make_guidingcache(device: super::Device, scene_bbox: super::BBox) -> GuidingCache {
        let grid       = (32, 32, 32);
        let voxel_area = grid.0 * grid.1 * grid.2 * NormalOctant;
        let elem_size  = GuidingCellMemoryFootprint * voxel_area;
        let buffer = device.request_buffer("__vmf_cache", elem_size, 0);
        make_guidingcache_voxel(device, buffer, grid, scene_bbox)
    }
    
    fn @make_guidingcache_voxel(device: super::Device, buffer: super::DeviceBuffer, grid: (i32, i32, i32), scene_bbox: super::BBox) -> GuidingCache {
        let bigger_box = super::bbox_grow(scene_bbox, 0.1);
        let scene_size = super::bbox_size(bigger_box);

        fn @get_index(pos: Vec3, _normal: Vec3) -> i32 {
            let o = super::vec3_sub(pos, bigger_box.min);
            let d = super::vec3_div(o, scene_size);
            let v = super::vec3_mul(d, super::make_vec3(grid.0 as f32, grid.1 as f32, grid.2 as f32));

            let ix = super::clamp(v.x as i32, 0, grid.0 - 1);
            let iy = super::clamp(v.y as i32, 0, grid.1 - 1);
            let iz = super::clamp(v.z as i32, 0, grid.2 - 1);

            let ik = 0;//vec3_octant(normal);

            ik * grid.0 * grid.1 * grid.2 + iz * grid.0 * grid.1 + iy * grid.0 + ix
        }

        fn @load_cell_raw(midx: i32) {
            let v0 = buffer.load_vec4(midx + 0);
            let v1 = buffer.load_vec4(midx + 4);
            
            GuidingCell {
                accum_mean   = super::vec4_to_3(v0),
                accum_weight = v0.w,
                mean         = super::vec4_to_3(v1),
                kappa        = v1.w,
                norm         = buffer.load_f32(midx + 8)
            }
        }

        fn @get_accessor(idx: i32, normal: Vec3) -> GuidingCellAccessor {
            let midx = idx * GuidingCellMemoryFootprint;

            fn @load_cell() {
                let cell = load_cell_raw(midx);
                let (newMean, newKappa, newNorm) = vmf_cosine_product(cell.mean, cell.kappa, normal);
                
                cell.{
                    mean  = newMean,
                    kappa = newKappa,
                    norm  = newNorm
                }
            }
            
            // fn @load_cell() = load_cell_raw(midx);

            GuidingCellAccessor {
                cell = load_cell,
                splat = @|dir: Vec3, contrib: Color| {
                    let weight = super::color_average(contrib);
                    let weighted_dir = super::vec3_mulf(dir, weight);
                    buffer.add_atomic_f32(midx + 0, weighted_dir.x);
                    buffer.add_atomic_f32(midx + 1, weighted_dir.y);
                    buffer.add_atomic_f32(midx + 2, weighted_dir.z);
                    buffer.add_atomic_f32(midx + 3, weight);
                },
                pdf = @|dir: Vec3| {
                    let cell = load_cell();
                    vmf_pdf(dir, cell.mean, cell.kappa, cell.norm)
                },
                sample = @|uv: Vec2| {
                    let cell = load_cell();
                    vmf_sample(uv, cell.mean, cell.kappa, cell.norm)
                },
                prob = @|| 1:f32,
                // prob = @|| {
                //     let cell = load_cell();
                //     super::clampf(1 - math_builtins::exp(-cell.kappa), 0, 1) // Does this make sense? I don't know... Does it kinda work? Sometimes
                // }
            }
        }

        fn @normalize_host(decay_factor: f32) {
            let voxel_area = grid.0 * grid.1 * grid.2 * NormalOctant;
            for i in device.parallel_range(0, voxel_area) {
                let midx = i * GuidingCellMemoryFootprint;
                let cell = load_cell_raw(midx);
                
                if cell.accum_weight > super::flt_eps {
                    // Decay previous statistics
                    buffer.store_vec4(midx + 0, super::vec4_mulf(super::make_vec4(cell.accum_mean.x, cell.accum_mean.y, cell.accum_mean.z, cell.accum_weight), decay_factor));

                    let mean = super::vec3_mulf(cell.accum_mean, 1 / cell.accum_weight);
                    let r = super::vec3_len(mean);

                    if r <= super::flt_eps {
                        buffer.store_vec4(midx + 4, super::vec4_expand(0));
                        buffer.store_f32(midx + 8, compute_normalization(0));
                    } else {
                        let norm_mean = super::vec3_mulf(mean, 1 / r);
                        let kappa = super::safe_div(r * (3 - r * r), 1 - r * r); // Approximation using (Sra, 2011)

                        buffer.store_vec4(midx + 4, super::make_vec4(norm_mean.x, norm_mean.y, norm_mean.z, kappa));
                        buffer.store_f32(midx + 8, compute_normalization(kappa));
                    }                    
                }
            }
            device.sync();
        }

        fn @reset_host() {
            let voxel_area = grid.0 * grid.1 * grid.2 * NormalOctant;
            for i in device.parallel_range(0, voxel_area * GuidingCellMemoryFootprint) {
                buffer.store_f32(i, 0);
            }
            device.sync();
        }

        GuidingCache {
            compute_index = @ |pos: Vec3, norm: Vec3| if super::bbox_check_point(bigger_box, pos) {
                super::make_option(get_index(pos, norm))
            } else {
                super::Option[i32]::None
            },
            get_from_index = get_accessor,
            normalize_host = normalize_host,
            reset_host     = reset_host,
        }
    }
}

static VMFTechniqueLastGuiding = 0x1;
struct VMFRayPayload {
    inv_pdf:    f32,   // Inverse BSDF+Guiding pdf
    contrib:    Color, // Current contribution
    depth:      i32,   // Current depth
    eta:        f32,   // Current eta (n1 / n2)
    prim_index: i32,   // Index of the primary cell
    prim_dir:   Vec3,  // Direction from the primary hit towards the light
}

fn @write_vmfraypayload(payload: RayPayload, pt: VMFRayPayload) -> () {
    payload.set( 0, pt.inv_pdf);
    payload.set( 1, pt.contrib.r);
    payload.set( 2, pt.contrib.g);
    payload.set( 3, pt.contrib.b);
    payload.set( 4, pt.depth as f32);
    payload.set( 5, pt.eta);
    payload.set( 6, pt.prim_index as f32);
    payload.set( 7, pt.prim_dir.x);
    payload.set( 8, pt.prim_dir.y);
    payload.set( 9, pt.prim_dir.z);
}

fn @unwrap_vmfraypayload(payload: RayPayload) = VMFRayPayload {
    inv_pdf    = payload.get(0),
    contrib    = make_color(payload.get(1), payload.get(2), payload.get(3), 1),
    depth      = payload.get(4) as i32,
    eta        = payload.get(5),
    prim_index = payload.get(6) as i32,
    prim_dir   = make_vec3(payload.get(7), payload.get(8), payload.get(9)),
};

fn @init_vmf_raypayload(payload: RayPayload) = write_vmfraypayload(payload, VMFRayPayload {
    inv_pdf    = 0,
    contrib    = color_builtins::white,
    depth      = 1,
    eta        = 1,
    prim_index = -1,
    prim_dir   = vec3_expand(0),
});

fn @make_vmf_renderer(device: Device, max_path_len: i32, min_path_len: i32, spi: i32, light_selector: LightSelector, clamp_value: f32, enable_nee: bool, enable_aovs: bool, defensive: f32, enable_training: bool, scene_bbox: BBox) -> Technique {
    let offset : f32  = 0.001;

    let aov_accum   = if enable_aovs { device.load_aov_image("Guided Accum",   spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };
    let aov_counter = if enable_aovs { device.load_aov_image("Guided Counter", spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };
    let aov_mean    = if enable_aovs { device.load_aov_image("Guided Mean",    spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };
    let aov_kappa   = if enable_aovs { device.load_aov_image("Guided Kappa",   spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };

    let handle_color = make_std_color_handler(clamp_value);

    let cache = vmf::make_guidingcache(device, scene_bbox);
    
    fn @map_normal_to_color(n: Vec3) = make_color((n.x+1)/2, (n.y+1)/2, (n.z+1)/2, 1);
    fn @map_scaled_normal_to_color(n: Vec3) {
        let norm = vec3_len(n);
        if norm <= flt_eps {
            color_builtins::black
        } else {
            make_color(norm*(n.x/norm+1)/2, norm*(n.y/norm+1)/2, norm*(n.z/norm+1)/2, 1)
        }
    }

    fn @on_shadow( ctx: ShadingContext
                 , rnd: RandomGenerator
                 , payload: RayPayload
                 , _: RayPayload
                 , mat: Material
                 ) -> ShadowRay {
        if !enable_nee {
            return(ShadowRay::None)
        }

        // No shadow rays for purely specular materials
        if mat.bsdf.is_all_delta || light_selector.count == 0 {
            return(ShadowRay::None)
        }
        
        let pt = unwrap_vmfraypayload(payload);
        if pt.depth + 1 > max_path_len {
            return(ShadowRay::None)
        }

        let (light, light_select_pdf) = light_selector.sample(rnd, ctx.surf.point);

        let sample_direct = light.sample_direct;
        let light_sample  = @sample_direct(rnd, ctx.surf);

        let pdf_l_s = light_sample.pdf.as_solid(light_sample.cos, light_sample.dist * light_sample.dist) * light_select_pdf; // Pdf to sample the light based on NEE
        if pdf_l_s <= flt_eps {
            return(ShadowRay::None)
        }

        let in_dir  = light_sample.dir; 
        let out_dir = vec3_neg(ctx.ray.dir);

        if light_sample.cos > flt_eps {
            let mis = if light.delta { 
                1:f32
            } else {
                let pdf_e_bsdf_s = mat.bsdf.pdf(in_dir, out_dir); // Pdf to sample the light based on bsdf
                if let Option[i32]::Some(gidx) = cache.compute_index(ctx.surf.point, ctx.surf.local.col(2)) {
                    let acc          = cache.get_from_index(gidx, ctx.surf.local.col(2));
                    let guiding_prob = (1 - defensive) * acc.prob();
                    let pdf_e_s      = (1 - guiding_prob) * pdf_e_bsdf_s + guiding_prob * acc.pdf(in_dir);
                    1 / (1 + pdf_e_s / pdf_l_s)
                } else {
                    1 / (1 + pdf_e_bsdf_s / pdf_l_s)
                }
                
            };

            // The intensity is already divided by the pdf, adapt to the (possible) change of domain
            let factor = light_sample.pdf.value / pdf_l_s;

            let contrib = handle_color(color_mulf(
                color_mul(light_sample.intensity, color_mul(pt.contrib, mat.bsdf.eval(in_dir, out_dir))), mis * factor));

            // No contribution to add, so do not shoot the ray to begin with.
            if color_average(contrib) <= flt_eps {
                return(ShadowRay::None)
            }

            if light.infinite {
                return(make_simple_shadow_ray(
                    make_ray(ctx.surf.point, in_dir, offset, flt_max, ray_flag_shadow),
                    contrib
                ))
            } else {
                return(make_simple_shadow_ray(
                    make_ray(ctx.surf.point, vec3_sub(light_sample.pos, ctx.surf.point), offset, 1 - offset, ray_flag_shadow),
                    contrib
                ))
            }
        }
        ShadowRay::None
    }

    fn @on_hit( ctx: ShadingContext
              , payload: RayPayload
              , mat: Material
              ) -> Option[Color] {
        let pt = unwrap_vmfraypayload(payload);

        // Hits on a light source
        if mat.is_emissive && ctx.surf.is_entering {
            let dot = -vec3_dot(ctx.ray.dir, ctx.surf.local.col(2));
            if dot > flt_eps { // Only contribute proper aligned directions
                let emit  = mat.emission(ctx);
                let pdf_s = emit.pdf.as_solid(dot, ctx.hit.distance * ctx.hit.distance);
                let mis   = if enable_nee { 1 / (1 + pt.inv_pdf * light_selector.pdf(mat.light, ctx.ray.org) * pdf_s) } else { 1:f32 };

                let contrib = handle_color(color_mulf(color_mul(pt.contrib, emit.intensity), mis));

                if enable_training && pt.prim_index >= 0 {
                    cache.get_from_index(pt.prim_index, ctx.surf.local.col(2)).splat(pt.prim_dir, contrib);
                }
                
                return(make_option(contrib))
            }
        }
        
        if pt.depth == 1 {
            if let Option[i32]::Some(gidx) = cache.compute_index(ctx.surf.point, ctx.surf.local.col(2)) {
                let cell = cache.get_from_index(gidx, ctx.surf.local.col(2)).cell();

                aov_accum.splat(ctx.pixel,   map_scaled_normal_to_color(cell.accum_mean));
                aov_counter.splat(ctx.pixel, make_gray_color(cell.accum_weight));
                aov_mean.splat(ctx.pixel,    map_normal_to_color(cell.mean));
                aov_kappa.splat(ctx.pixel,   make_gray_color(cell.kappa));
            }
        }

        Option[Color]::None
    }

    fn @on_miss( ctx: ShadingContext
               , payload: RayPayload) -> Option[Color] {
        let mut inflights = 0;
        let mut color     = color_builtins::black;

        let pt = unwrap_vmfraypayload(payload);

        for light_id in safe_unroll(0, light_selector.infinites.count) {
            let light = light_selector.infinites.get(light_id);
            // Do not include delta lights or finite lights
            if light.infinite && !light.delta {
                inflights += 1;

                let emit = light.emission(ctx);
                if is_black_eps(emit, flt_eps) { continue() }
            
                let pdf   = light.pdf_direct(ctx.ray, make_invalid_surface_element());
                let pdf_s = pdf.as_solid(1, 1/* We assume infinite lights are always given in solid angle measure */);
                let mis   = if enable_nee { 1 / (1 + pt.inv_pdf * light_selector.pdf(light, ctx.ray.org) * pdf_s) } else { 1:f32 };

                color = color_add(color, handle_color(color_mulf(color_mul(pt.contrib, emit), mis)));
            }
        }

        if inflights > 0 {
            if enable_training && pt.prim_index >= 0 {
                cache.get_from_index(pt.prim_index, ctx.surf.local.col(2)).splat(pt.prim_dir, color);
            }
            make_option(color)
        } else {
            Option[Color]::None
        }
    }

    fn @on_bounce( ctx: ShadingContext
                 , rnd: RandomGenerator
                 , payload: RayPayload
                 , mat: Material
                 ) -> Option[Ray] {
        let pt = unwrap_vmfraypayload(payload);
        
        if pt.depth + 1 > max_path_len {
            return(Option[Ray]::None)
        }

        // Bounce
        let out_dir = vec3_neg(ctx.ray.dir);

        if let Option[i32]::Some(gidx) = cache.compute_index(ctx.surf.point, ctx.surf.local.col(2)) {
            let cell   = cache.get_from_index(gidx, ctx.surf.local.col(2));
            let g_prob = if mat.bsdf.is_all_delta { 0:f32 } else { (1 - defensive) * cell.prob() };

            if rnd.next_f32() < g_prob {
                // Guiding Sampling
                let dir_sample = cell.sample(make_vec2(rnd.next_f32(), rnd.next_f32()));
                
                // This should not really happen, but better be safe 
                if g_prob * dir_sample.pdf <= flt_eps {
                    return(Option[Ray]::None)
                }
    
                let full_pdf = (1 - g_prob) * mat.bsdf.pdf(dir_sample.dir, out_dir) + g_prob * dir_sample.pdf;
                let inv_pdf  = safe_div(1, full_pdf);
                let mat_eval = mat.bsdf.eval(dir_sample.dir, out_dir);
                
                let contrib = color_mul(pt.contrib, color_mulf(mat_eval, inv_pdf));
                let rr_prob = if pt.depth + 1 > min_path_len { russian_roulette_pbrt(color_mulf(contrib, pt.eta * pt.eta), 0.95) } else { 1.0 };
                if rnd.next_f32() >= rr_prob {
                    return(Option[Ray]::None)
                }
    
                let new_contrib = color_mulf(contrib, 1 / rr_prob);

                // This might happen due to wrong hemisphere, etc
                if color_average(new_contrib) <= flt_eps {
                    return(Option[Ray]::None)
                }

                write_vmfraypayload(payload, VMFRayPayload {
                    inv_pdf    = inv_pdf,
                    contrib    = new_contrib,
                    depth      = pt.depth + 1,
                    eta        = pt.eta, // * mat_sample.eta (TODO)
                    prim_index = if pt.prim_index < 0 { gidx } else { pt.prim_index },
                    prim_dir   = if pt.prim_index < 0 { dir_sample.dir } else { pt.prim_dir },
                });
                make_option(
                    make_ray(ctx.surf.point, dir_sample.dir, offset, flt_max, ray_flag_bounce)
                )
            } else {
                // BSDF Sampling
                if let Option[BsdfSample]::Some(mat_sample) = mat.bsdf.sample(rnd, out_dir, false) {
                    // This should not really happen, but better be safe 
                    if mat_sample.pdf <= flt_eps {
                        return(Option[Ray]::None)
                    }
    
                    let full_pdf = if mat_sample.is_delta { mat_sample.pdf } else { (1 - g_prob) * mat_sample.pdf + g_prob * cell.pdf(mat_sample.in_dir) };
                    let inv_pdf  = safe_div(1, full_pdf);
                    let mat_eval = color_mulf(mat_sample.color, mat_sample.pdf);

                    let contrib = color_mul(pt.contrib, color_mulf(mat_eval, inv_pdf));
                    let rr_prob = if pt.depth + 1 > min_path_len { russian_roulette_pbrt(color_mulf(contrib, pt.eta * pt.eta), 0.95) } else { 1.0 };
                    if rnd.next_f32() >= rr_prob {
                        return(Option[Ray]::None)
                    }
    
                    let new_contrib = color_mulf(contrib, 1 / rr_prob);
                
                    // This might happen due to wrong hemisphere, etc
                    if color_average(new_contrib) <= flt_eps {
                        return(Option[Ray]::None)
                    }

                    write_vmfraypayload(payload, VMFRayPayload {
                        inv_pdf    = inv_pdf,
                        contrib    = new_contrib,
                        depth      = pt.depth + 1,
                        eta        = pt.eta * mat_sample.eta,
                        prim_index = if pt.prim_index < 0 && !mat_sample.is_delta { gidx } else { pt.prim_index },
                        prim_dir   = if pt.prim_index < 0 && !mat_sample.is_delta { mat_sample.in_dir } else { pt.prim_dir },
                    });
                    make_option(
                        make_ray(ctx.surf.point, mat_sample.in_dir, offset, flt_max, ray_flag_bounce)
                    )
                } else {
                    Option[Ray]::None
                }
            }
        } else {
            // Should never happen as the cache is over the entire scene!
            Option[Ray]::None
        }
    }

    make_empty_technique().{
        on_hit    = on_hit,
        on_miss   = on_miss,
        on_shadow = on_shadow,
        on_bounce = on_bounce
    }
}

fn @vmf_handle_before_iteration(device: Device, iter: i32, max_learn_iter: i32, scene_bbox: BBox, decay_factor: f32) -> () {
    if iter > max_learn_iter {
        /* Ignore */
    } else if iter == 1 { 
        vmf::make_guidingcache(device, scene_bbox).reset_host()
    } else {
        vmf::make_guidingcache(device, scene_bbox).normalize_host(decay_factor)
    }
}
