

fn @make_debug_renderer(device: Device, spi: i32) -> Technique {
    let global_normal_aov           = device.load_aov_image("Global Normal",           spi, 0);
    let global_tangent_aov          = device.load_aov_image("Global Tangent",          spi, 0);
    let global_bitangent_aov        = device.load_aov_image("Global Bitangent",        spi, 0);
    let global_geometric_normal_aov = device.load_aov_image("Global Geometric Normal", spi, 0);
    let local_normal_aov            = device.load_aov_image("Local Normal",            spi, 0);
    let local_tangent_aov           = device.load_aov_image("Local Tangent",           spi, 0);
    let local_bitangent_aov         = device.load_aov_image("Local Bitangent",         spi, 0);
    let local_geometric_normal_aov  = device.load_aov_image("Local Geometric Normal",  spi, 0);
    let texcoord_aov                = device.load_aov_image("Texcoord",                spi, 0);
    let primcoord_aov               = device.load_aov_image("Primcoord",               spi, 0);
    let generated_coord_aov         = device.load_aov_image("Gencoord",                spi, 0);
    let global_point_aov            = device.load_aov_image("Global Point",            spi, 0);
    let local_point_aov             = device.load_aov_image("Local Point",             spi, 0);
    let hit_distance_aov            = device.load_aov_image("Hit Distance ",           spi, 0);
    let area_aov                    = device.load_aov_image("Area",                    spi, 0);
    let prim_id_map_aov             = device.load_aov_image("PrimID",                  spi, 0);
    let entity_id_map_aov           = device.load_aov_image("EntityID",                spi, 0);
    let material_id_map_aov         = device.load_aov_image("MaterialID",              spi, 0);
    let object_id_raw_aov           = device.load_aov_image("Raw IDs",                 spi, 0);
    let bsdf_type_aov               = device.load_aov_image("BSDF Type",               spi, 0);
    let check_bsdf_aov              = device.load_aov_image("Check BSDF",              spi, 0);
    let medium_inner_map_aov        = device.load_aov_image("Medium Inner",            spi, 0);
    let medium_outer_map_aov        = device.load_aov_image("Medium Outer",            spi, 0);
    let medium_raw_aov              = device.load_aov_image("Raw Medium IDs",          spi, 0);

    fn @map_normal_to_color(n: Vec3) = make_color(math_builtins::fabs(n.x), math_builtins::fabs(n.y), math_builtins::fabs(n.z), 1);
    fn @map_tex_to_color(n: Vec2)    = make_color(math_builtins::fabs(n.x), math_builtins::fabs(n.y), 0, 1);

    fn @check_bsdf(ctx: ShadingContext, mat: Material) -> Color {
        let out_dir = vec3_neg(ctx.ray.dir);
        if mat.bsdf.is_all_delta {
            // PDF & Eval of specular materials should always return black / zero
            let evl = mat.bsdf.eval(vec3_reflect(out_dir, ctx.surf.local.col(2)), out_dir);
            let pdf = mat.bsdf.pdf( vec3_reflect(out_dir, ctx.surf.local.col(2)), out_dir);

            let pdf_diff = math_builtins::fabs(0 - pdf);
            let w_diff   = math_builtins::fabs(0 - evl.r)
                            + math_builtins::fabs(0 - evl.g)
                            + math_builtins::fabs(0 - evl.b);

            let pdf_good = select(pdf_diff <= flt_eps, 1:i32, 0:i32);
            let w_good   = select(w_diff   <= flt_eps, 1:i32, 0:i32);
            let index    = (w_good << 1) | pdf_good;
            let color    = [color_builtins::red, color_builtins::orange, color_builtins::yellow, color_builtins::blue](index);
            color
        } else {
            let tmp_rnd = create_random_generator(hash_combine(hash_combine(hash_combine(hash_init(),
                                        bitcast[u32](ctx.hit.distance)),
                                    bitcast[u32](ctx.hit.prim_coords.x)),
                                bitcast[u32](ctx.hit.prim_coords.y)));
            if let Option[BsdfSample]::Some(mat_sample) = mat.bsdf.sample(tmp_rnd, out_dir, false) {    
                let pdf = mat.bsdf.pdf(mat_sample.in_dir, out_dir);
                let evl = color_mulf(mat.bsdf.eval(mat_sample.in_dir, out_dir), safe_div(1, pdf));

                let pdf_diff = math_builtins::fabs(mat_sample.pdf - pdf);
                let w_diff   = math_builtins::fabs(mat_sample.color.r - evl.r)
                                + math_builtins::fabs(mat_sample.color.g - evl.g)
                                + math_builtins::fabs(mat_sample.color.b - evl.b);

                let pdf_good = select(pdf_diff <= 0.001:f32, 1:i32, 0:i32);
                let w_good   = select(w_diff   <= 0.001:f32, 1:i32, 0:i32);
                let index    = (w_good << 1) | pdf_good;
                let color    = [color_builtins::red, color_builtins::orange, color_builtins::yellow, color_builtins::blue](index);
                color
            } else { 
                color_builtins::pink
            }
        }
    }

    make_empty_technique().{
        on_hit = @ |ctx, _, mat| {
            global_normal_aov.splat(          ctx.pixel, map_normal_to_color(ctx.surf.local.col(2)));
            global_tangent_aov.splat(         ctx.pixel, map_normal_to_color(ctx.surf.local.col(0)));
            global_bitangent_aov.splat(       ctx.pixel, map_normal_to_color(ctx.surf.local.col(1)));
            global_geometric_normal_aov.splat(ctx.pixel, map_normal_to_color(ctx.surf.face_normal));
            local_normal_aov.splat(           ctx.pixel, map_normal_to_color(ctx.coord.to_local_normal(ctx.surf.local.col(2))));
            local_tangent_aov.splat(          ctx.pixel, map_normal_to_color(ctx.coord.to_local_normal(ctx.surf.local.col(0))));
            local_bitangent_aov.splat(        ctx.pixel, map_normal_to_color(ctx.coord.to_local_normal(ctx.surf.local.col(1))));
            local_geometric_normal_aov.splat( ctx.pixel, map_normal_to_color(ctx.coord.to_local_normal(ctx.surf.face_normal)));
            texcoord_aov.splat(               ctx.pixel, map_tex_to_color(ctx.surf.tex_coords));
            primcoord_aov.splat(              ctx.pixel, map_tex_to_color(ctx.hit.prim_coords));
            generated_coord_aov.splat(        ctx.pixel, vec3_to_color(ctx.coord.to_normalized_point(ctx.surf.point)));
            global_point_aov.splat(           ctx.pixel, vec3_to_color(ctx.surf.point));
            local_point_aov.splat(            ctx.pixel, vec3_to_color(ctx.coord.to_local_point(ctx.surf.point)));
            hit_distance_aov.splat(           ctx.pixel, make_gray_color(ctx.hit.distance));
            area_aov.splat(                   ctx.pixel, make_gray_color(ctx.surf.area));
            prim_id_map_aov.splat(            ctx.pixel, colormap::palette(ctx.hit.prim_id));
            entity_id_map_aov.splat(          ctx.pixel, colormap::palette(ctx.hit.ent_id));
            material_id_map_aov.splat(        ctx.pixel, colormap::palette(mat.id));
            object_id_raw_aov.splat(          ctx.pixel, make_color(ctx.hit.prim_id as f32, ctx.hit.ent_id as f32, mat.id as f32, 1));
            bsdf_type_aov.splat(              ctx.pixel, make_color(select(mat.is_emissive, 1:f32, 0:f32), select(mat.bsdf.is_all_delta, 1:f32, 0:f32), select(ctx.surf.is_entering, 1:f32, 0:f32), 1));
            check_bsdf_aov.splat(             ctx.pixel, check_bsdf(ctx, mat));
            medium_inner_map_aov.splat(       ctx.pixel, if mat.interface.inner < 0 { color_builtins::black } else { colormap::palette(mat.interface.inner) });
            medium_outer_map_aov.splat(       ctx.pixel, if mat.interface.outer < 0 { color_builtins::black } else { colormap::palette(mat.interface.outer) });
            medium_raw_aov.splat(             ctx.pixel, make_color(mat.interface.inner as f32, mat.interface.outer as f32, 0, 1));
            make_option(color_builtins::white)
        }
    }
}
