struct VisibilityCache {
    splat:          fn (i32, f32)   -> (),          // Add weight to the cell
    get:            fn (i32)        -> f32,         // Get the normalized weight for the position or none if outside bounds
    get_vis:        fn (i32)        -> (f32, f32, f32),
    index:          fn (Vec3, Vec3) -> Option[i32], // Map the index
    index_unsafe:   fn (Vec3, Vec3) -> i32,         // Map the index
    normalize_host: fn (f32)        -> (),          // Normalize on the host 
    reset_host:     fn ()           -> (),          // Reset on the host 
}
static VisibilityCacheCellSize     = 4;
static VisibilityCacheNormalOctant = 1;//8;

struct VisibilityVoxel {
    splat:     fn (f32) -> (),
    get:       fn ()    -> (f32, f32, f32)
}

fn @make_vgpt_visibilitycache(device: Device, scene_bbox: BBox) {
    let grid       = (32, 32, 32);
    let voxel_area = grid.0 * grid.1 * grid.2 * VisibilityCacheNormalOctant;
    let elem_size  = VisibilityCacheCellSize * voxel_area;
    let buffer = device.request_buffer("__vgpt_vis_cache", elem_size, 0);
    make_vgpt_visibilitycache_voxel(device, buffer, grid, scene_bbox)
}

fn @make_vgpt_visibilitycache_voxel(device: Device, buffer: DeviceBuffer, grid: (i32, i32, i32), scene_bbox: BBox) -> VisibilityCache {
    let bigger_box = bbox_grow(scene_bbox, 0.1);
    let scene_size = bbox_size(bigger_box);

    fn @get_index(pos: Vec3, _normal: Vec3) -> i32 {
        let o = vec3_sub(pos, bigger_box.min);
        let d = vec3_div(o, scene_size);
        let v = vec3_mul(d, make_vec3(grid.0 as f32, grid.1 as f32, grid.2 as f32));

        let ix = clamp(v.x as i32, 0, grid.0 - 1);
        let iy = clamp(v.y as i32, 0, grid.1 - 1);
        let iz = clamp(v.z as i32, 0, grid.2 - 1);

        let ik = 0;//vec3_octant(normal);

        ik * grid.0 * grid.1 * grid.2 + iz * grid.0 * grid.1 + iy * grid.0 + ix
    }

    fn @get_voxel(idx: i32) -> VisibilityVoxel {
        let midx = idx * VisibilityCacheCellSize;

        VisibilityVoxel {
            splat = @|v:f32| {
                buffer.add_atomic_f32(midx + 1, v);
                buffer.add_atomic_f32(midx + 2, 1);
            },
            get = @|| {
                let v = buffer.load_vec4(midx);
                (v.x, v.y, v.z)
            }
        }
    }

    fn @normalize_host(decay_factor: f32) {
        let voxel_area = grid.0 * grid.1 * grid.2 * VisibilityCacheNormalOctant;
        for i in device.parallel_range(0, voxel_area) {
            let midx = i * VisibilityCacheCellSize;
            let v = buffer.load_vec4(midx);

            let PowerFactor = 8:f32;
            let cw = v.y;
            let cc = v.z;

            let f = math_builtins::fmax[f32](math_builtins::pow(cw / (cc+1), 1/PowerFactor), 0.05);
            buffer.store_vec4(midx, make_vec4(f, cw * decay_factor, cc * decay_factor, 0));
        }
        device.sync();
    }

    fn @reset_host() {
        let voxel_area = grid.0 * grid.1 * grid.2 * VisibilityCacheNormalOctant;
        for i in device.parallel_range(0, voxel_area) {
            let idx = i * VisibilityCacheCellSize;
            buffer.store_vec4(idx, make_vec4(1, 0, 0, 0));
        }
        device.sync();
    }

    VisibilityCache {
        splat   = @ |idx: i32, w:f32|     get_voxel(idx).splat(w),
        get     = @ |idx: i32|            get_voxel(idx).get().0,
        get_vis = @ |idx: i32|            get_voxel(idx).get(),
        index   = @ |pos: Vec3, norm: Vec3| if bbox_check_point(bigger_box, pos) {
            make_option(get_index(pos, norm))
        } else {
            Option[i32]::None
        },
        index_unsafe   = @ |pos: Vec3, norm: Vec3| get_index(pos, norm),
        normalize_host = normalize_host,
        reset_host     = reset_host,
    }
}

static VGPTTechniqueGuiding = 0x1;
struct VGPTRayPayload {
    inv_pdf:    f32,   // Inverse pdf
    contrib:    Color, // Current contribution
    depth:      i32,   // Current depth
    eta:        f32,   // Current eta (n1 / n2)
    flags:      i32,   // Technique
    prim_index: i32,   // Index of the primary cell
}

fn @write_vgptraypayload(payload: RayPayload, pt: VGPTRayPayload) -> () {
    payload.set( 0, pt.inv_pdf);
    payload.set( 1, pt.contrib.r);
    payload.set( 2, pt.contrib.g);
    payload.set( 3, pt.contrib.b);
    payload.set( 4, pt.depth as f32);
    payload.set( 5, pt.eta);
    payload.set( 6, pt.flags as f32);
    payload.set( 7, pt.prim_index as f32);
}

fn @unwrap_vgptraypayload(payload: RayPayload) = VGPTRayPayload {
    inv_pdf    = payload.get(0),
    contrib    = make_color(payload.get(1), payload.get(2), payload.get(3), 1),
    depth      = payload.get(4) as i32,
    eta        = payload.get(5),
    flags      = payload.get(6) as i32,
    prim_index = payload.get(7) as i32,
};

fn @init_vgpt_raypayload(payload: RayPayload) = write_vgptraypayload(payload, VGPTRayPayload {
    inv_pdf    = 0,
    contrib    = color_builtins::white,
    depth      = 1,
    eta        = 1,
    flags      = 0,
    prim_index = -1,
});

struct VisibilityGuidingTechnique {
    sample:       fn (RandomGenerator, Vec3) -> (Vec3, f32),
    pdf:          fn (Vec3, Vec3) -> f32,
    get_vis:      fn (Vec3, Vec3) -> (f32, f32, f32), // Values for visualization purposes
    prob:         fn (Vec3, Vec3) -> f32,             // Probability to use this guider
    index:        fn (Vec3, Vec3) -> Option[i32],
    index_unsafe: fn (Vec3, Vec3) -> i32,
    record_miss:  fn (i32) -> (),
    record_hit:   fn (i32, i32) -> ()
}

fn @make_vgpt_renderer(device: Device, max_path_len: i32, min_path_len: i32, spi: i32, light_selector: LightSelector, clamp_value: f32, enable_nee: bool, enable_aovs: bool, guider: VisibilityGuidingTechnique) -> Technique {
    let offset : f32  = 0.001;

    let aov_prob    = if enable_aovs { device.load_aov_image("Guided Prob",    spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };
    let aov_accum   = if enable_aovs { device.load_aov_image("Guided Accum",   spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };
    let aov_counter = if enable_aovs { device.load_aov_image("Guided Counter", spi, AOV_FLAG_SNAPSHOT) } else { make_empty_aov_image(0, 0) };

    let handle_color = make_std_color_handler(clamp_value);

    fn @on_shadow( ctx: ShadingContext
                 , rnd: RandomGenerator
                 , payload: RayPayload
                 , _: RayPayload
                 , mat: Material
                 ) -> ShadowRay {
        if !enable_nee {
            return(ShadowRay::None)
        }

        // No shadow rays for purely specular materials
        if mat.bsdf.is_all_delta || light_selector.count == 0 {
            return(ShadowRay::None)
        }
        
        let pt = unwrap_vgptraypayload(payload);
        if pt.depth + 1 > max_path_len {
            return(ShadowRay::None)
        }

        let (light, light_select_pdf) = light_selector.sample(rnd, ctx.surf.point);

        let sample_direct = light.sample_direct;
        let light_sample  = @sample_direct(rnd, ctx.surf);

        let pdf_l_s = light_sample.pdf.as_solid(light_sample.cos, light_sample.dist * light_sample.dist) * light_select_pdf; // Pdf to sample the light based on NEE
        if pdf_l_s <= flt_eps {
            return(ShadowRay::None)
        }

        let in_dir  = light_sample.dir; 
        let out_dir = vec3_neg(ctx.ray.dir);

        if light_sample.cos > flt_eps {
            let mis = if light.delta { 
                1:f32
            } else {
                let guided_prob    = guider.prob(ctx.surf.point, ctx.surf.local.col(2));
                let pdf_e_bsdf_s   = (1 - guided_prob) * mat.bsdf.pdf(in_dir, out_dir); // Pdf to sample the light based on bsdf
                let pdf_e_guided_s =       guided_prob * guider.pdf(in_dir, out_dir);
                1 / (1 + pdf_e_bsdf_s / pdf_l_s + pdf_e_guided_s / pdf_l_s)
            };

            // The intensity is already divided by the pdf, adapt to the (possible) change of domain
            let factor = light_sample.pdf.value / pdf_l_s;

            let contrib = handle_color(color_mulf(
                color_mul(light_sample.intensity, color_mul(pt.contrib, mat.bsdf.eval(in_dir, out_dir))), mis * factor));

            // No contribution to add, so do not shoot the ray to begin with.
            if color_average(contrib) <= flt_eps {
                return(ShadowRay::None)
            }

            if light.infinite {
                return(make_simple_shadow_ray(
                    make_ray(ctx.surf.point, in_dir, offset, flt_max, ray_flag_shadow),
                    contrib
                ))
            } else {
                return(make_simple_shadow_ray(
                    make_ray(ctx.surf.point, vec3_sub(light_sample.pos, ctx.surf.point), offset, 1 - offset, ray_flag_shadow),
                    contrib
                ))
            }
        }
        ShadowRay::None
    }

    fn @on_hit( ctx: ShadingContext
              , payload: RayPayload
              , mat: Material
              ) -> Option[Color] {
        let pt = unwrap_vgptraypayload(payload);

        // Hits on a light source
        if mat.is_emissive && ctx.surf.is_entering {
            let dot = -vec3_dot(ctx.ray.dir, ctx.surf.local.col(2));
            if dot > flt_eps { // Only contribute proper aligned directions
                let emit  = mat.emission(ctx);
                let pdf_s = emit.pdf.as_solid(dot, ctx.hit.distance * ctx.hit.distance);
                let mis   = if enable_nee { 1 / (1 + pt.inv_pdf * light_selector.pdf(mat.light, ctx.ray.org) * pdf_s) } else { 1:f32 };

                let contrib = handle_color(color_mulf(color_mul(pt.contrib, emit.intensity), mis));
                
                return(make_option(contrib))
            }
        }
        
        if pt.depth == 1 {
            let vis = guider.get_vis(ctx.surf.point, ctx.surf.local.col(2));
            aov_prob.splat(ctx.pixel,    make_gray_color(vis.0));
            aov_accum.splat(ctx.pixel,   make_gray_color(vis.1));
            aov_counter.splat(ctx.pixel, make_gray_color(vis.2));
        }

        Option[Color]::None
    }

    fn @on_miss( ctx: ShadingContext
               , payload: RayPayload) -> Option[Color] {
        let mut inflights = 0;
        let mut color     = color_builtins::black;

        let pt = unwrap_vgptraypayload(payload);

        for light_id in safe_unroll(0, light_selector.infinites.count) {
            let light = light_selector.infinites.get(light_id);
            // Do not include delta lights or finite lights
            if light.infinite && !light.delta {
                inflights += 1;

                let emit = light.emission(ctx);
                if is_black_eps(emit, flt_eps) { continue() }
            
                let pdf   = light.pdf_direct(ctx.ray, make_invalid_surface_element());
                let pdf_s = pdf.as_solid(1, 1/* We assume infinite lights are always given in solid angle measure */);
                let mis   = if enable_nee { 1 / (1 + pt.inv_pdf * light_selector.pdf(light, ctx.ray.org) * pdf_s) } else { 1:f32 };

                color = color_add(color, handle_color(color_mulf(color_mul(pt.contrib, emit), mis)));

                if (pt.flags & VGPTTechniqueGuiding) == VGPTTechniqueGuiding {
                    if color_average(emit) > 0 && pdf_s > 0 {
                        guider.record_hit(pt.prim_index, light_id);
                    } else {
                        guider.record_miss(pt.prim_index);
                    }
                }
            } else {
                if (pt.flags & VGPTTechniqueGuiding) == VGPTTechniqueGuiding {
                    guider.record_miss(pt.prim_index);
                }
            }
        }

        if inflights > 0 {
            make_option(color)
        } else {
            Option[Color]::None
        }
    }

    fn @on_bounce( ctx: ShadingContext
                 , rnd: RandomGenerator
                 , payload: RayPayload
                 , mat: Material
                 ) -> Option[Ray] {
        let pt = unwrap_vgptraypayload(payload);

        fn @zero_contrib() {
            if (pt.flags & VGPTTechniqueGuiding) == VGPTTechniqueGuiding {
                guider.record_miss(pt.prim_index);
            }
        }
        
        if pt.depth + 1 > max_path_len {
            zero_contrib();
            return(Option[Ray]::None)
        }

        // Bounce
        let out_dir = vec3_neg(ctx.ray.dir);

        let g_prob = if mat.bsdf.is_all_delta { 0:f32 } else { guider.prob(ctx.surf.point, ctx.surf.local.col(2)) };
        if rnd.next_f32() < g_prob {
            // Guiding Sampling
            let (in_dir, pdf_g_s) = guider.sample(rnd, out_dir);
            
            // This should not really happen, but better be safe 
            if pdf_g_s <= flt_eps {
                zero_contrib();
                return(Option[Ray]::None)
            }

            let full_pdf = (1 - g_prob) * mat.bsdf.pdf(in_dir, out_dir) + g_prob * pdf_g_s;
            let inv_pdf  = 1 / full_pdf;
            let mat_eval = mat.bsdf.eval(in_dir, out_dir);
            
            let contrib = color_mul(pt.contrib, color_mulf(mat_eval, inv_pdf));
            let rr_prob = if pt.depth + 1 > min_path_len { russian_roulette_pbrt(color_mulf(contrib, pt.eta * pt.eta), 0.95) } else { 1.0 };
            if rnd.next_f32() >= rr_prob {
                zero_contrib();
                return(Option[Ray]::None)
            }

            let new_contrib = color_mulf(contrib, 1 / rr_prob);

            // This might happen due to wrong hemisphere, texture, etc
            if color_average(new_contrib) <= flt_eps {
                zero_contrib();
                return(Option[Ray]::None)
            }

            write_vgptraypayload(payload, VGPTRayPayload {
                inv_pdf    = inv_pdf,
                contrib    = new_contrib,
                depth      = pt.depth + 1,
                eta        = pt.eta, // * mat_sample.eta (TODO)
                flags      = VGPTTechniqueGuiding, /* Guiding */
                prim_index = if pt.prim_index < 0 { guider.index_unsafe(ctx.surf.point, ctx.surf.local.col(2)) } else { pt.prim_index },
            });
            make_option(
                make_ray(ctx.surf.point, in_dir, offset, flt_max, ray_flag_bounce)
            )
        } else {
            // BSDF Sampling
            if let Option[BsdfSample]::Some(mat_sample) = mat.bsdf.sample(rnd, out_dir, false) {
                // This should not really happen, but better be safe 
                if mat_sample.pdf <= flt_eps {
                    zero_contrib();
                    return(Option[Ray]::None)
                }

                let full_pdf = if mat_sample.is_delta { mat_sample.pdf } else { (1 - g_prob) * mat_sample.pdf + g_prob * guider.pdf(mat_sample.in_dir, out_dir) };
                let inv_pdf  = 1/ full_pdf;
                let mat_eval = color_mulf(mat_sample.color, mat_sample.pdf);

                let contrib = color_mul(pt.contrib,  color_mulf(mat_eval, inv_pdf));
                let rr_prob = if pt.depth + 1 > min_path_len { russian_roulette_pbrt(color_mulf(contrib, pt.eta * pt.eta), 0.95) } else { 1.0 };
                if rnd.next_f32() >= rr_prob {
                    zero_contrib();
                    return(Option[Ray]::None)
                }

                let new_contrib = color_mulf(contrib, 1 / rr_prob);
            
                // This might happen due to wrong hemisphere, texture, etc
                if color_average(new_contrib) <= flt_eps {
                    zero_contrib();
                    return(Option[Ray]::None)
                }
                
                write_vgptraypayload(payload, VGPTRayPayload {
                    inv_pdf    = inv_pdf,
                    contrib    = new_contrib,
                    depth      = pt.depth + 1,
                    eta        = pt.eta * mat_sample.eta,
                    flags      = pt.flags,
                    prim_index = if pt.prim_index < 0 && !mat_sample.is_delta { guider.index_unsafe(ctx.surf.point, ctx.surf.local.col(2)) } else { pt.prim_index }
                });
                make_option(
                    make_ray(ctx.surf.point, mat_sample.in_dir, offset, flt_max, ray_flag_bounce)
                )
            } else {
                Option[Ray]::None
            }
        }
    }

    make_empty_technique().{
        on_hit    = on_hit,
        on_miss   = on_miss,
        on_shadow = on_shadow,
        on_bounce = on_bounce
    }
}

// Basic Guiding towards one single light (e.g., Sun)
fn @make_light_vgpt_renderer(device: Device, max_path_len: i32, min_path_len: i32, spi: i32, light_selector: LightSelector, clamp_value: f32, enable_nee: bool, enable_aovs: bool, light: Light, defensive: f32, enable_learning: bool, scene_bbox: BBox) -> Technique {
    // TODO: Assuming it is a infinite light!
    let cache = make_vgpt_visibilitycache(device, scene_bbox);

    fn @sample(rnd: RandomGenerator, _out_dir: Vec3) {
        let light_sample = light.sample_direct(rnd, make_invalid_surface_element());
        let pdf_l_s      = light_sample.pdf.as_solid(light_sample.cos, light_sample.dist * light_sample.dist);
        (light_sample.dir, pdf_l_s)
    }

    fn @pdf(in_dir: Vec3, _out_dir: Vec3) {
        let in_ray = make_ray(vec3_expand(0), in_dir, 0, flt_max, ray_flag_bounce);
        light.pdf_direct(in_ray, make_invalid_surface_element()).as_solid(1, 1/* We assume infinite lights are always given in solid angle measure */)
    }

    let guider = VisibilityGuidingTechnique {
        sample       = sample,
        pdf          = pdf,
        get_vis      = @|pos:Vec3, norm: Vec3| cache.get_vis(cache.index_unsafe(pos, norm)),
        prob         = @|pos:Vec3, norm: Vec3| (1 - defensive) * cache.get(cache.index_unsafe(pos, norm)),
        index        = @|pos:Vec3, norm: Vec3| cache.index(pos, norm),
        index_unsafe = @|pos:Vec3, norm: Vec3| cache.index_unsafe(pos, norm),
        record_miss  = @|idx:i32| if enable_learning && idx >= 0 { cache.splat(idx, 0) },
        // record_hit  = @|idx:i32, _light_id:i32| if enable_learning && idx >= 0 { cache.splat(idx, 1) },
        record_hit   = @|idx:i32, light_id:i32| if enable_learning && idx >= 0 { cache.splat(idx, select(light_id == light.id, 1:f32, 0:f32)) } else { /* Ignore */ },
    };

    make_vgpt_renderer(device, max_path_len, min_path_len, spi, light_selector, clamp_value, enable_nee, enable_aovs, guider)
}

fn @vgpt_handle_before_iteration(device: Device, iter: i32, max_learn_iter: i32, scene_bbox: BBox, decay_factor: f32) -> () {
    if iter > max_learn_iter {
        /* Ignore */
    } else if iter == 1 { 
        make_vgpt_visibilitycache(device, scene_bbox).reset_host()
    } else {
        make_vgpt_visibilitycache(device, scene_bbox).normalize_host(decay_factor)
    }
}
